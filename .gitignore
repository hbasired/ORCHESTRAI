# ML weights: tracked via Git LFS (see .gitattributes). Do NOT ignore the
# extensions globally — LFS needs git to see them. We only ignore the
# heavy intermediate /models/ runtime cache directory.
models/

# Data: ignore everything under data/ EXCEPT the scaffolding we want
# visible. Real dataset binaries live behind DVC, not git.
data/*
!data/datasets/
data/datasets/*
!data/datasets/.gitkeep
!data/datasets/CARD.template.md
# Stage 25 (G-061): procedural-memory skills are DVC-versioned — the .dvc POINTER is git-tracked, the content is not.
!data/skills.dvc

# DVC remote store sibling
/dvc-store/

# OS
.DS_Store
Thumbs.db
*.swp
*~

# Docker
.docker/

# Recordings
recordings/

# Temporary
tmp/
temp/
*.tmp

# Secrets
*.pem
*.key
credentials.json
firebase-credentials.json
service-account.json

# Database
*.db
*.sqlite
*.sqlite3

# Audit baseline is checked in deliberately (each stage tightens it).
!.audit-baseline

# Stage 13.5 software-tier key store (dev secrets; production uses HSM)
backend/crypto/.keystore/

# Stage 21 — DR/backups: artefacts are large + environment-specific; never commit them.
/backups/
*.dump
*.rdb

# Local credentials reference — never commit
CREDENTIALS.md
