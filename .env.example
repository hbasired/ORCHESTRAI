# =============================================================================
# AI Embodied Agent — Environment Variable Template
# =============================================================================
# Copy this file to `.env.local` (git-ignored) and fill in real values.
# Every variable referenced by `docker/docker-compose.yml` and `backend/config.py`
# is documented here. If you see `REPLACE_ME`, the system will fail to start
# until you provide a real value.
#
# Source of truth for which vars are required: this file. If you add a new
# env var to compose or config, add it here too — CI does not currently
# enforce this, but `KB_10_Production_Hardening.md` mandates it.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
DEBUG=true
LOG_LEVEL=INFO
SIMULATION_MODE=true
MOCK_ROBOT_COUNT=20
MOCK_STAGE_COUNT=10

# CORS — comma-separated list of allowed origins, or a JSON array string
CORS_ORIGINS=["http://localhost:3000"]

# -----------------------------------------------------------------------------
# Postgres / Supabase (self-hosted via docker compose, post Stage 1)
# -----------------------------------------------------------------------------
POSTGRES_USER=aiagent
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=manufacturing
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Supabase cloud (optional — local self-hosted stack is the default)
SUPABASE_URL=
SUPABASE_KEY=

# -----------------------------------------------------------------------------
# Neo4j
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_ME

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# LLM providers
# -----------------------------------------------------------------------------
# Groq — primary LLM provider for Stage 11 agent orchestration
GROQ_API_KEY=REPLACE_ME

# Gemini — secondary; used for multi-provider failover
GEMINI_API_KEY=REPLACE_ME

# Ollama — local fallback (Stage 11 acceptance criterion: demo must survive a
# Groq outage). Default points at host machine's Ollama daemon.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# -----------------------------------------------------------------------------
# External APIs
# -----------------------------------------------------------------------------
OPENWEATHER_API_KEY=

# -----------------------------------------------------------------------------
# MQTT (IoT sensor stream)
# -----------------------------------------------------------------------------
MQTT_BROKER_HOST=mqtt
MQTT_BROKER_PORT=1883

# -----------------------------------------------------------------------------
# Frontend (Next.js) — surfaces these at build time
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
